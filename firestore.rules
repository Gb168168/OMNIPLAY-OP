rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'xqDN3vaLfufEkz4TZ1omSmGkQ2A2'
          || (member().enabled == true && member().get('superAdmin', false) == true
            && member().username.lower() == 'cia_cia'));
    }
    function member() {
      return get(/databases/$(database)/documents/omniplay-member-access/$(request.auth.uid)).data;
    }
    function canViewGroup(groupId) {
      return request.auth != null && member().enabled == true
        && member().groupId == groupId
        && get(/databases/$(database)/documents/omniplay-group-views/$(groupId)).data.enabled == true;
    }
    match /omniplay-member-access/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    match /omniplay-group-views/{groupId} {
      allow get: if canViewGroup(groupId);
      match /documents/{documentId} {
        allow get: if canViewGroup(groupId)
          && documentId in get(/databases/$(database)/documents/omniplay-group-views/$(groupId)).data.allowedDocumentIds;
      }
    }
    match /omniplay-audit-events/{eventId} {
      allow read: if request.auth != null && member().enabled == true
        && member().internal == true && member().username.lower() == 'k';
      allow create: if request.auth != null && member().enabled == true
        && request.resource.data.keys().hasOnly(['authUid', 'username', 'name', 'groupName', 'action', 'item', 'createdAt', 'createdAtIso'])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == member().username
        && request.resource.data.name == member().name
        && request.resource.data.groupName == member().groupName
        && request.resource.data.action in ['login', 'download']
        && request.resource.data.item is string && request.resource.data.item.size() <= 180
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtIso is string;
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
