rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function configExists() { return exists(/databases/$(database)/documents/omniplay-security/access); }
    function config() { return get(/databases/$(database)/documents/omniplay-security/access).data; }
    function ownerUid() { return configExists() ? config().ownerUid : 'xqDN3vaLfufEkz4TZ1omSmGkQ2A2'; }
    function isOwner() { return signedIn() && request.auth.uid == ownerUid(); }
    function isRondo() { return isOwner() && ownerUid() != 'xqDN3vaLfufEkz4TZ1omSmGkQ2A2'; }
    function member() { return get(/databases/$(database)/documents/omniplay-member-access/$(request.auth.uid)).data; }
    function isAdmin() {
      return isOwner() || (signedIn() && configExists() && config().credentialsMigrated == true
        && member().enabled == true && member().groupName in ['OMNIPLAY', 'OMNIPLAY Support']);
    }
    function canViewGroup(groupId) {
      return signedIn() && member().enabled == true && member().groupId == groupId
        && get(/databases/$(database)/documents/omniplay-group-views/$(groupId)).data.enabled == true;
    }
    function allowedDocument(groupId, documentId) {
      let view = get(/databases/$(database)/documents/omniplay-group-views/$(groupId)).data;
      return documentId in view.allowedDocumentIds
        || (documentId.matches('sheet-.+')
          && documentId.replace('^sheet-', '').replace('-chunk-[0-9]+$', '') in view.get('allowedPages', []));
    }
    function validTransfer() {
      let uid = request.resource.data.ownerUid;
      return uid == 'xqDN3vaLfufEkz4TZ1omSmGkQ2A2'
        || (get(/databases/$(database)/documents/omniplay-member-access/$(uid)).data.enabled == true
          && get(/databases/$(database)/documents/omniplay-member-access/$(uid)).data.username.lower() == 'rondo');
    }
    match /omniplay-security/access {
      allow get: if signedIn();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['ownerUid', 'ownerUsername', 'credentialsMigrated'])
        && request.resource.data.credentialsMigrated == true && validTransfer();
      allow update: if isOwner() && request.resource.data.keys().hasOnly(['ownerUid', 'ownerUsername', 'credentialsMigrated'])
        && request.resource.data.credentialsMigrated == true
        && (isRondo() ? request.resource.data.ownerUid == resource.data.ownerUid : validTransfer());
    }
    match /omniplay-member-access/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.role in ['member', 'admin']
        && (request.resource.data.role == 'member' || isRondo())
        && (uid != ownerUid() || (request.resource.data.enabled == true && request.resource.data.username.lower() == 'rondo'));
      allow delete: if isOwner() && uid != ownerUid();
    }
    function templateEditor() {
      return isRondo() || (isAdmin() && !isOwner()
        && exists(/databases/$(database)/documents/omniplay-template-grants/$(request.auth.uid)));
    }
    match /omniplay-template-grants/{uid} {
      allow list, delete: if isRondo();
      allow get: if isRondo() || (signedIn() && uid == request.auth.uid);
      allow create, update: if isRondo()
        && get(/databases/$(database)/documents/omniplay-member-access/$(uid)).data.groupName in ['OMNIPLAY','OMNIPLAY Support']
        && get(/databases/$(database)/documents/omniplay-member-access/$(uid)).data.enabled == true
        && request.resource.data == {'enabled': true};
    }
    function templateFields(v) {
      return v is map && v.keys().hasOnly(['titleZh','titleEn','messageZh','messageEn'])
        && v.titleZh is string && v.titleZh.size() <= 200 && v.titleEn is string && v.titleEn.size() <= 200
        && v.messageZh is string && v.messageZh.size() <= 2000 && v.messageEn is string && v.messageEn.size() <= 2000;
    }
    match /omniplay-notification-templates/{type} {
      function revision(d) {
        return d.keys().hasOnly(['fields','before','revision','uid','at','author'])
          && templateFields(d.fields) && templateFields(d.before)
          && (d.fields.titleZh.size() > 0 || d.fields.titleEn.size() > 0)
          && d.revision is string && d.revision.matches('[a-zA-Z0-9]{20}')
          && d.uid == request.auth.uid && d.at == request.time
          && d.author == (isRondo() ? 'Rondo' : member().username)
          && !exists(/databases/$(database)/documents/omniplay-notification-templates/$(type)/history/$(d.revision))
          && getAfter(/databases/$(database)/documents/omniplay-notification-templates/$(type)/history/$(d.revision)).data == d;
      }
      allow read: if isAdmin();
      allow create: if templateEditor() && revision(request.resource.data);
      allow update: if templateEditor() && revision(request.resource.data) && request.resource.data.before == resource.data.fields;
      match /history/{rev} {
        allow read: if templateEditor();
        allow create: if templateEditor() && rev == request.resource.data.revision
          && getAfter(/databases/$(database)/documents/omniplay-notification-templates/$(type)).data == request.resource.data;
      }
    }
    match /omniplay-member-bindings/{id} { allow read, write: if isOwner(); }
    match /omniplay-member-secrets/{id} { allow read, write: if isOwner(); }
    match /omniplay-platform-access/{platformId} {
      allow read, write: if isAdmin();
    }
    function canViewApproval(gameId, approval) {
      let profile = member();
      let platformId = profile.get('platformId', '');
      let platform = get(/databases/$(database)/documents/omniplay-platform-access/$(platformId)).data;
      let view = get(/databases/$(database)/documents/omniplay-group-views/$(profile.groupId)).data;
      let catalog = get(/databases/$(database)/documents/omniplay-group-views/$(profile.groupId)/documents/op-game-customer-records).data;
      return profile.enabled == true && platformId != '' && platform.enabled == true
        && platform.groupId == profile.groupId && view.enabled == true
        && 'op-game-customer-records' in view.allowedDocumentIds
        && gameId in catalog.records
        && platformId in approval.allowedPlatformIds;
    }
    match /omniplay-pagcor-approvals/{gameId} {
      allow get: if isAdmin() || (signedIn() && canViewApproval(gameId, resource.data));
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['allowedPlatformIds', 'items', 'fileIds', 'revision', 'updatedAt'])
        && request.resource.data.allowedPlatformIds is list
        && request.resource.data.allowedPlatformIds.size() <= 400
        && request.resource.data.items is list && request.resource.data.items.size() <= 50
        && request.resource.data.fileIds is list && request.resource.data.fileIds.size() <= 50
        && request.resource.data.revision is int;
      allow delete: if isAdmin();
      match /files/{fileId}/chunks/{index} {
        allow get: if isAdmin() || (signedIn()
          && fileId in get(/databases/$(database)/documents/omniplay-pagcor-approvals/$(gameId)).data.fileIds
          && canViewApproval(gameId, get(/databases/$(database)/documents/omniplay-pagcor-approvals/$(gameId)).data));
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 349528;
        allow delete: if isAdmin();
      }
    }
    match /omniplay-release-notifications/{notificationId} {
      allow read, write: if isAdmin();
      match /images/{imageId} {
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 400000
          && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+');
        allow delete: if isAdmin();
        allow get: if isAdmin() || (signedIn()
          && canViewGroup(member().groupId)
          && get(/databases/$(database)/documents/omniplay-release-notifications/$(notificationId)).data.status == 'published'
          && member().groupId in get(/databases/$(database)/documents/omniplay-release-notifications/$(notificationId)).data.groupIds);
      }
    }
    match /omniplay-api-guide/{entryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    function categoryManager() {
      return isAdmin() && member().groupName == 'OMNIPLAY Support'
        && member().role == 'admin' && member().get('manageGroupCategories', false) == true;
    }
    match /omniplay-group-category-changes/{uid} {
      allow create, update: if categoryManager() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['action','index','at'])
        && request.resource.data.action in ['create','rename','delete']
        && request.resource.data.index is int && request.resource.data.at == request.time;
    }
    match /omniplay-group-category-ids/{id} {
      allow create: if categoryManager() && id.matches('managed-[0-9a-f-]{36}')
        && request.resource.data == {'createdAt':request.time};
    }
    function freshCategoryId(id) {
      return id is string && id.matches('managed-[0-9a-f-]{36}')
        && !exists(/databases/$(database)/documents/omniplay-group-category-ids/$(id))
        && getAfter(/databases/$(database)/documents/omniplay-group-category-ids/$(id)).data.createdAt == request.time;
    }
    function ordinaryCategoryName(name) {
      return name is string && name.size()>0 && name.size()<=100 && name==name.trim()
        && !(name.lower() in ['omniplay','omniplay support']);
    }
    function validCategoryChange() {
      let op = getAfter(/databases/$(database)/documents/omniplay-group-category-changes/$(request.auth.uid)).data;
      let before = resource.data.customerGroups;
      let after = request.resource.data.customerGroups;
      let i = op.index;
      return op.at == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerGroups'])
        && ((op.action == 'create' && after.size() == before.size()+1
            && after == before.concat([after[before.size()]])
            && after[before.size()].keys().hasOnly(['id','name','allowedPages','pageOrder','permissionMode'])
            && freshCategoryId(after[before.size()].id) && ordinaryCategoryName(after[before.size()].name)
            && after[before.size()].allowedPages == [] && after[before.size()].pageOrder == [] && after[before.size()].permissionMode == 'all')
          || (i >= 0 && i < before.size() && ordinaryCategoryName(before[i].name)
            && ((op.action == 'rename' && before.size() == after.size()
              && ordinaryCategoryName(after[i].name) && after[i].diff(before[i]).affectedKeys().hasOnly(['name'])
              && before.removeAll([before[i]]) == after.removeAll([after[i]]))
            || (op.action == 'delete' && before[i].get('members',[]) == [] && after == before.removeAll([before[i]])))));
    }
    match /omniplay/{documentId} {
      allow update: if documentId == 'workspace' && categoryManager() && validCategoryChange();
      allow read: if isAdmin();
      allow create, update, delete: if isOwner() && documentId != 'game-release-notifications';
      allow create, update, delete: if isAdmin() && documentId != 'game-release-notifications' && documentId != 'workspace';
      allow update: if isAdmin() && documentId == 'workspace'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'categories', 'customers', 'customerTypeOptions', 'customerProgressOptions',
          'customerCommAppOptions', 'customerOptionVersion', 'platformImportVersion', 'updatedAt'
        ]);
    }
    match /omniplay-group-views/{groupId} {
      allow read: if isAdmin();
      allow get: if canViewGroup(groupId);
      allow write: if isOwner();
      allow update: if isAdmin() && request.resource.data.allowedPages == resource.data.allowedPages
        && request.resource.data.allowedDocumentIds == resource.data.allowedDocumentIds
        && request.resource.data.enabled == resource.data.enabled;
      match /documents/{documentId} {
        allow read: if isAdmin();
        allow get: if canViewGroup(groupId)
          && allowedDocument(groupId, documentId);
        allow write: if isOwner() || (isAdmin()
          && allowedDocument(groupId, documentId));
      }
    }
    match /omniplay-active-sessions/{sessionId} {
      allow get: if isAdmin() || (signedIn() && (!exists(/databases/$(database)/documents/omniplay-active-sessions/$(sessionId)) || resource.data.authUid == request.auth.uid));
      allow list: if isAdmin();
      allow create: if signedIn() && (isOwner() || member().enabled == true)
        && request.resource.data.keys().hasOnly(['authUid','username','name','groupName','startedAt','lastSeen','active','revoked'])
        && request.resource.data.authUid == request.auth.uid
        && (isOwner() || (request.resource.data.username == member().username && request.resource.data.groupName == member().groupName))
        && request.resource.data.startedAt == request.time && request.resource.data.lastSeen == request.time
        && request.resource.data.active == true && request.resource.data.revoked == false;
      allow update: if signedIn() && resource.data.authUid == request.auth.uid && resource.data.revoked == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen','active'])
        && request.resource.data.lastSeen == request.time && request.resource.data.active is bool;
      allow update: if isAdmin() && resource.data.authUid != ownerUid() && resource.data.authUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked','active','kickedAt','kickedBy'])
        && request.resource.data.revoked == true && request.resource.data.active == false
        && request.resource.data.kickedAt == request.time && request.resource.data.kickedBy == request.auth.uid;
    }
    match /omniplay-audit-events/{eventId} {
      allow read: if isAdmin() || (signedIn() && member().enabled == true
        && member().internal == true && member().username.lower() == 'k');
      allow create: if signedIn() && member().enabled == true
        && request.resource.data.keys().hasOnly(['authUid', 'username', 'name', 'groupName', 'action', 'item', 'createdAt', 'createdAtIso'])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == member().username
        && request.resource.data.name == member().name
        && request.resource.data.groupName == member().groupName
        && request.resource.data.action in ['login', 'logout', 'download']
        && request.resource.data.item is string && request.resource.data.item.size() <= 180
        && request.resource.data.createdAt == request.time && request.resource.data.createdAtIso is string;
      allow create: if isOwner() && request.resource.data.authUid == request.auth.uid
        && request.resource.data.action in ['login', 'logout', 'download'] && request.resource.data.createdAt == request.time;
    }
  }
}


